# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cowrie
POSTGRES_USER=cowrie
POSTGRES_PASSWORD=change-me-strong-password

# ── reCAPTCHA v2 ("I'm not a robot" checkbox) ────────────────────────────────
# Register at https://www.google.com/recaptcha/admin/create  (type: v2 Checkbox)
RECAPTCHA_SITE_KEY=6LeXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RECAPTCHA_SECRET_KEY=6LeXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Malware hash analysis ─────────────────────────────────────────────────────
# MalwareBazaar (abuse.ch) is always queried — no key needed.
# VirusTotal is optional; leave blank to skip it.
VIRUSTOTAL_API_KEY=

# ── Nginx routing ─────────────────────────────────────────────────────────────
# Requests with this Host header are routed to the stats dashboard.
# All other hosts go to the web honeypot.
TARGET_HOST=honey.gmelodie.com

# ── Let's Encrypt ─────────────────────────────────────────────────────────────
# Used by scripts/init-letsencrypt.sh  (not read by docker-compose directly)
CERTBOT_EMAIL=you@example.com

# ── Federation (honey/) ───────────────────────────────────────────────────────
# Where the Rust binary keeps state (node.key etc.). Mounted into honey-* containers.
HONEY_DATA_DIR=/data/honey

# Human-readable identity advertised to peers. Optional but recommended.
HONEY_NODE_NAME=honey-eu-west-1
HONEY_CONTACT=admin@example.com

# Federation daemon bind. Nginx fronts this; do not expose directly.
HONEY_FEDERATION_BIND=127.0.0.1:8088

# Peer-pull cadence (seconds) and signed-envelope clock-skew tolerance.
HONEY_POLL_INTERVAL_SECS=10
HONEY_MAX_SKEW_SECS=300

# Externally-reachable URL we advertise to peers (typically https://host).
HONEY_PUBLIC_URL=http://127.0.0.1:8088

# Loopback URL the CLI and Flask admin panel use to talk to the daemon.
HONEY_DAEMON_INTERNAL_URL=http://127.0.0.1:8088

# Admin panel basic-auth (nginx-enforced on /admin/).
# Generate the hash with:  openssl passwd -apr1 'your-password'
# Wrap the hash in single quotes so the leading $ isn't interpolated by docker compose.
# Leave HONEY_ADMIN_USER empty to lock /admin/ down entirely.
HONEY_ADMIN_USER=admin
HONEY_ADMIN_PASSWORD_HASH='$apr1$abcd1234$EXAMPLEHASHREPLACEME................/'
